<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_amount_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.amount.reject.wizard.form</field>
        <field name="model">purchase.amount.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <field name="order_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this order rejected?"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_amount_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Purchase Order</field>
        <field name="res_model">purchase.amount.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
