<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_amount_approval" model="ir.ui.view">
        <field name="name">sale.order.form.amount.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_amount_approve" type="object" string="Approve"
                        class="oe_highlight" invisible="state != 'to_approve'"
                        groups="sale_amount_approval.group_so_amount_approver"/>
                <button name="%(action_sale_amount_reject_wizard)d" type="action" string="Reject"
                        invisible="state != 'to_approve'" context="{'default_order_id': id}"
                        groups="sale_amount_approval.group_so_amount_approver"/>
            </xpath>
        </field>
    </record>
</odoo>
