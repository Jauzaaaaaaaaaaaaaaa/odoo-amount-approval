<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_amount_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.amount.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='no_edit_order']" position="after">
                <setting id="so_amount_approval" company_dependent="1" string="Amount Approval Limit"
                         help="Quotations above this amount wait for an Amount Approver (0 = off)">
                    <field name="so_amount_approval_limit"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
