<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_amount_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.amount.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='po_order_approval']" position="after">
                <setting id="po_amount_approval" company_dependent="1" string="Amount Approval Limit"
                         help="Orders above this amount wait for an Amount Approver (0 = off)">
                    <field name="po_amount_approval_limit"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
